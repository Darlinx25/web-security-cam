# ===== Configuracion =====
# Copia este archivo como .env y ajusta lo que haga falta.

# go2rtc corre DENTRO de la laptop (en docker), apuntando directo a las camaras.
# Si dejas GO2RTC_HOST vacio, el navegador usa la propia laptop (recomendado).
GO2RTC_HOST=
GO2RTC_HLS_PORT=1984

# Cada cuantos segundos dura cada clip
SEGMENT_SECONDS=30

# Cuantos dias se conservan los clips (despues se borran solos)
RETENTION_DAYS=5

# Incluir audio en los clips (1 = si, 0 = no)
AUDIO=1

# Clave que usan grabador y web entre ellos. Cambiala.
API_TOKEN=cambia-este-token

# Puerto de la web
WEB_PORT=8080

# Base de datos (solo tocar si sabes lo que haces)
DB_ROOT_PASSWORD=root
DB_NAME=clips
DB_USER=clipapp
DB_PASSWORD=clipapp

# Zona horaria
TZ=America/Argentina/Buenos_Aires
